{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "angular"
      }
    }
  },
  "hooks": {
    "after:bump": "echo ${version} > VERSION && node scripts/update-env-version.js ${version}",
    "before:release": "git add VERSION .env.example"
  }
}
